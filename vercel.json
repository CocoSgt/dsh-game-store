{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "node site/build.mjs",
  "outputDirectory": "site/dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/__dsh/ai.js",
      "has": [
        {
          "type": "host",
          "value": "(?<game>[a-z0-9-]+)\\.play\\.dsh-game-store\\.com"
        }
      ],
      "destination": "/dsh-ai-web.js"
    },
    {
      "source": "/v/:pkg([a-z0-9][a-z0-9._-]*@[0-9][0-9A-Za-z.+-]*)/:path(.*\\.html?)",
      "has": [
        {
          "type": "host",
          "value": "(?<game>[a-z0-9-]+)\\.play\\.dsh-game-store\\.com"
        }
      ],
      "destination": "https://unpkg.com/:pkg/:path"
    },
    {
      "source": "/v/:pkg([a-z0-9][a-z0-9._-]*@[0-9][0-9A-Za-z.+-]*)/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<game>[a-z0-9-]+)\\.play\\.dsh-game-store\\.com"
        }
      ],
      "destination": "https://cdn.jsdelivr.net/npm/:pkg/:path*"
    },
    {
      "source": "/catalog.json",
      "destination": "/api/page?f=catalog"
    },
    {
      "source": "/dsh-index.json",
      "destination": "/api/page?f=index"
    },
    {
      "source": "/",
      "destination": "/api/page?p="
    },
    {
      "source": "/en/",
      "destination": "/api/page?p=en/"
    },
    {
      "source": "/ja/",
      "destination": "/api/page?p=ja/"
    },
    {
      "source": "/es/",
      "destination": "/api/page?p=es/"
    },
    {
      "source": "/fr/",
      "destination": "/api/page?p=fr/"
    },
    {
      "source": "/de/",
      "destination": "/api/page?p=de/"
    },
    {
      "source": "/ru/",
      "destination": "/api/page?p=ru/"
    },
    {
      "source": "/pt/",
      "destination": "/api/page?p=pt/"
    },
    {
      "source": "/:page((?:(?:en|ja|es|fr|de|ru|pt)/)?(?:games|workshop|publish|install|docs|spec)(?:/.*)?)",
      "destination": "/api/page?p=:page"
    }
  ],
  "redirects": [
    {
      "source": "/v/:pkg/manual/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<game>[a-z0-9-]+)\\.play\\.dsh-game-store\\.com"
        },
        {
          "type": "header",
          "key": "sec-fetch-dest",
          "value": "document"
        }
      ],
      "destination": "https://dsh-game-store.com/games/:game/manual/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<game>[a-z0-9-]+)\\.play\\.dsh-game-store\\.com"
        },
        {
          "type": "header",
          "key": "sec-fetch-dest",
          "value": "document"
        }
      ],
      "destination": "https://dsh-game-store.com/games/:game/play/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<game>[a-z0-9-]+)\\.play\\.dsh-game-store\\.com"
        }
      ],
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob:; connect-src 'self' data: blob: *; object-src 'none'; form-action 'none'; base-uri 'self'; frame-ancestors https://dsh-game-store.com https://www.dsh-game-store.com"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|gif|avif|woff2|woff|ttf|otf|mp3|ogg|wav|m4a|mp4|webm)",
      "has": [
        {
          "type": "host",
          "value": "(?<game>[a-z0-9-]+)\\.play\\.dsh-game-store\\.com"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|mjs|css|json|wasm)",
      "has": [
        {
          "type": "host",
          "value": "(?<game>[a-z0-9-]+)\\.play\\.dsh-game-store\\.com"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/SKILL.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "functions": {
    "api/page.mjs": {
      "includeFiles": "api/_lib/**",
      "maxDuration": 30
    }
  }
}
