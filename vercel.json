{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "node site/build.mjs",
  "outputDirectory": "site/dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/game/index.html",
      "has": [
        {
          "type": "host",
          "value": "batto\\-neko\\.play\\.dsh-game-store\\.com"
        }
      ],
      "destination": "/_play/batto-neko/game/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "batto\\-neko\\.play\\.dsh-game-store\\.com"
        }
      ],
      "destination": "https://cdn.jsdelivr.net/npm/dsh-game-batto-neko@0.11.2-alpha.3/:path*"
    },
    {
      "source": "/game/index.html",
      "has": [
        {
          "type": "host",
          "value": "tidemark\\.play\\.dsh-game-store\\.com"
        }
      ],
      "destination": "/_play/tidemark/game/index.html"
    },
    {
      "source": "/manual/index.html",
      "has": [
        {
          "type": "host",
          "value": "tidemark\\.play\\.dsh-game-store\\.com"
        }
      ],
      "destination": "/_play/tidemark/manual/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tidemark\\.play\\.dsh-game-store\\.com"
        }
      ],
      "destination": "https://cdn.jsdelivr.net/npm/dsh-game-tidemark@1.0.4/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/manual/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<game>[a-z0-9-]+)\\.play\\.dsh-game-store\\.com"
        },
        {
          "type": "header",
          "key": "sec-fetch-dest",
          "value": "document"
        }
      ],
      "destination": "https://dsh-game-store.com/games/:game/manual/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<game>[a-z0-9-]+)\\.play\\.dsh-game-store\\.com"
        },
        {
          "type": "header",
          "key": "sec-fetch-dest",
          "value": "document"
        }
      ],
      "destination": "https://dsh-game-store.com/games/:game/play/",
      "permanent": false
    },
    {
      "source": "/_play/:game/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?dsh-game-store\\.com"
        }
      ],
      "destination": "https://:game.play.dsh-game-store.com/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<game>[a-z0-9-]+)\\.play\\.dsh-game-store\\.com"
        }
      ],
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "batto\\-neko\\.play\\.dsh-game-store\\.com"
        }
      ],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob:; connect-src 'self' data: blob: https://soya-knight-dsh.pages.dev; object-src 'none'; form-action 'none'; base-uri 'self'; frame-ancestors https://dsh-game-store.com https://www.dsh-game-store.com"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tidemark\\.play\\.dsh-game-store\\.com"
        }
      ],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob:; connect-src 'self' data: blob:; object-src 'none'; form-action 'none'; base-uri 'self'; frame-ancestors https://dsh-game-store.com https://www.dsh-game-store.com"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|gif|avif|woff2|woff|ttf|otf|mp3|ogg|wav|m4a|mp4|webm)",
      "has": [
        {
          "type": "host",
          "value": "(?<game>[a-z0-9-]+)\\.play\\.dsh-game-store\\.com"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|mjs|css|json|wasm)",
      "has": [
        {
          "type": "host",
          "value": "(?<game>[a-z0-9-]+)\\.play\\.dsh-game-store\\.com"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/SKILL.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(catalog|dsh-index)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/games/(.*)\\.(png|jpg|jpeg|webp|mp4|webm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
